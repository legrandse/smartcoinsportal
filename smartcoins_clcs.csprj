<treenode node="crypto_aead_chacha20poly1305_encrypt;PHP:Function Name;3117689904;f18;728;5;767;;;;vpos;;v;;astring;;r&#10;&lt;b&gt;Definition&lt;/b&gt;&#10;    crypto_aead_chacha20poly1305_encrypt(&#10;        #[SensitiveParameter]&#10;        string $plaintext = &apos;&apos;,&#10;        string $assocData = &apos;&apos;,&#10;        string $nonce = &apos;&apos;,&#10;        #[SensitiveParameter]&#10;        string $key = &apos;&apos;&#10;    ): string&#10;&#10;&lt;b&gt;Description&lt;/b&gt;&#10;    Authenticated Encryption with Associated Data&#10;Algorithm:&#10;ChaCha20-Poly1305&#10;This mode uses a 64-bit random nonce with a 64-bit counter.&#10;IETF mode uses a 96-bit random nonce with a 32-bit counter.&#10;&lt;b&gt;throws&lt;/b&gt;: SodiumException&#10;&lt;b&gt;throws&lt;/b&gt;: TypeError&#10;&#10;&lt;b&gt;Parameters:&lt;/b&gt;&#10;    string &lt;b&gt;$plaintext&lt;/b&gt;: Message to be encrypted&#10;    string &lt;b&gt;$assocData&lt;/b&gt;: Authenticated Associated Data (unencrypted)&#10;    string &lt;b&gt;$nonce&lt;/b&gt;: Number to be used only Once;s must be 8 bytes&#10;    string &lt;b&gt;$key&lt;/b&gt;: Encryption key&#10;&#10;&lt;b&gt;Return:&lt;/b&gt;&#10;   Ciphertext with a 16-byte Poly1305 message authentication code appended;;d14,735;;b1,5;;m0;;e0;;i0;;o;;k;;l $plaintext;;p $assocData;;p $nonce;;p $key;;p;;x;;x;;x;;x;;n">
</treenode>
<treenode node="crypto_aead_chacha20poly1305_ietf_decrypt;PHP:Function Name;3117689904;f18;787;13;793;;;;vpos;;v;;astring|bool;;r&#10;&lt;b&gt;Description&lt;/b&gt;&#10;    Authenticated Encryption with Associated Data: Decryption&#10;Algorithm:&#10;ChaCha20-Poly1305&#10;IETF mode uses a 96-bit random nonce with a 32-bit counter.&#10;Regular mode uses a 64-bit random nonce with a 64-bit counter.&#10;&lt;b&gt;throws&lt;/b&gt;: SodiumException&#10;&lt;b&gt;throws&lt;/b&gt;: TypeError&#10;&#10;&lt;b&gt;Parameters:&lt;/b&gt;&#10;    string &lt;b&gt;$ciphertext&lt;/b&gt;: Encrypted message (with Poly1305 MAC appended)&#10;    string &lt;b&gt;$assocData&lt;/b&gt;: Authenticated Associated Data (unencrypted)&#10;    string &lt;b&gt;$nonce&lt;/b&gt;: Number to be used only Once;s must be 12 bytes&#10;    string &lt;b&gt;$key&lt;/b&gt;: Encryption key&#10;&#10;&lt;b&gt;Return:&lt;/b&gt;&#10;        The original plaintext message;;d-1,-1;;b1,5;;m0;;e0;;i0;;o;;k;;l $ciphertext;;p $assocData;;p $nonce;;p $key;;p;;x;;x;;x;;x;;n">
</treenode>
<treenode node="crypto_aead_chacha20poly1305_ietf_encrypt;PHP:Function Name;3117689904;f18;862;5;901;;;;vpos;;v;;astring;;r&#10;&lt;b&gt;Definition&lt;/b&gt;&#10;    crypto_aead_chacha20poly1305_ietf_encrypt(&#10;        #[SensitiveParameter]&#10;        string $plaintext = &apos;&apos;,&#10;        string $assocData = &apos;&apos;,&#10;        string $nonce = &apos;&apos;,&#10;        #[SensitiveParameter]&#10;        string $key = &apos;&apos;&#10;    ): string&#10;&#10;&lt;b&gt;Description&lt;/b&gt;&#10;    Authenticated Encryption with Associated Data&#10;Algorithm:&#10;ChaCha20-Poly1305&#10;IETF mode uses a 96-bit random nonce with a 32-bit counter.&#10;Regular mode uses a 64-bit random nonce with a 64-bit counter.&#10;&lt;b&gt;throws&lt;/b&gt;: SodiumException&#10;&lt;b&gt;throws&lt;/b&gt;: TypeError&#10;&#10;&lt;b&gt;Parameters:&lt;/b&gt;&#10;    string &lt;b&gt;$plaintext&lt;/b&gt;: Message to be encrypted&#10;    string &lt;b&gt;$assocData&lt;/b&gt;: Authenticated Associated Data (unencrypted)&#10;    string &lt;b&gt;$nonce&lt;/b&gt;: Number to be used only Once;s must be 8 bytes&#10;    string &lt;b&gt;$key&lt;/b&gt;: Encryption key&#10;&#10;&lt;b&gt;Return:&lt;/b&gt;&#10;   Ciphertext with a 16-byte Poly1305 message authentication code appended;;d14,869;;b1,5;;m0;;e0;;i0;;o;;k;;l $plaintext;;p $assocData;;p $nonce;;p $key;;p;;x;;x;;x;;x;;n">
</treenode>
