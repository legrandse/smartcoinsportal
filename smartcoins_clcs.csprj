</treenode>
<treenode node="crypto_pwhash;PHP:Function Name;3117689904;f18;1875;5;1898;;;;vpos;;v;;astring;;r&#10;&lt;b&gt;Definition&lt;/b&gt;&#10;    crypto_pwhash(&#10;        int $outlen,&#10;        #[SensitiveParameter]&#10;        string $passwd,&#10;        #[SensitiveParameter]&#10;        string $salt,&#10;        int $opslimit,&#10;        int $memlimit,&#10;        ?int $alg = null&#10;    ): string&#10;&#10;&lt;b&gt;Description&lt;/b&gt;&#10;    &lt;b&gt;throws&lt;/b&gt;: SodiumException&#10;&lt;b&gt;throws&lt;/b&gt;: TypeError&#10;&#10;&lt;b&gt;Parameters:&lt;/b&gt;&#10;    int &lt;b&gt;$outlen&lt;/b&gt;&#10;    string &lt;b&gt;$passwd&lt;/b&gt;&#10;    string &lt;b&gt;$salt&lt;/b&gt;&#10;    int &lt;b&gt;$opslimit&lt;/b&gt;&#10;    int &lt;b&gt;$memlimit&lt;/b&gt;&#10;    int|null &lt;b&gt;$alg&lt;/b&gt;;;d14,1884;;b1,5;;m0;;e0;;i0;;o;;k;;l $outlen;;p $passwd;;p $salt;;p $opslimit;;p $memlimit;;p $alg;;p;;x;;x;;x;;x;;x;;x;;n">
</treenode>
